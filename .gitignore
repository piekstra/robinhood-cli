# Build artifacts
/target
**/*.rs.bk

# Environment / editor
.env
.DS_Store
.idea/
.vscode/

# Credentials must never be committed
*.pem
*.key
secrets.*

# Raw provider captures. A capture from api.robinhood.com carries real account
# numbers, positions, and balances, and a document `url` is a live pre-signed
# link. Scrub into tests/fixtures/ by hand; never commit the raw file.
raw-*.json
capture-*.json
*.raw.json

# Downloaded tax documents / statements
*.pdf

# Local, machine-specific notes: profile names, account particulars, anything
# that identifies whose install this is.
*.local.md
NOTES.local.md
